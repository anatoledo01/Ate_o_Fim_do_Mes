# Supabase Configuration
# Preencha com as credenciais do seu projeto Supabase (Configurações do Projeto > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Caso as variáveis acima não estejam configuradas, a aplicação opera automaticamente
# no modo de Demonstração / Armazenamento Local Seguro (com dados do usuário isolados
# no navegador e aviso claro de modo demo), permitindo testar 100% dos fluxos.
