# -------------------------------------------------------------
# Supabase Configuration
# Preencha com as credenciais do seu projeto Supabase (Project Settings > API)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# -------------------------------------------------------------
# Brevo (Sendinblue) - Disparo de E-mails Transacionais
# Obtenha em: Brevo Dashboard > SMTP & API > API Keys
# -------------------------------------------------------------
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=contato@seudominio.com
BREVO_SENDER_NAME="Até o Fim do Mês"

# -------------------------------------------------------------
# DICA: Para autenticação e recuperação de senha no Supabase via Brevo:
# No Supabase Dashboard: Project Settings > Authentication > SMTP Settings:
#   Enable Custom SMTP: ON
#   Host: smtp-relay.brevo.com
#   Port: 587
#   Username: seu-email-login-brevo
#   Password: sua-master-password-ou-smtp-key-do-brevo
#   Sender Email: seu-email-verificado-no-brevo
#   Sender Name: Até o Fim do Mês
# -------------------------------------------------------------
